{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quocan050302/Seecut-AI/schemas/kh03/layout_plan.schema.json",
  "title": "KH-03.R2 Adaptive Dynamic Layout Plan Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "selected_skill_id",
    "layout_policy",
    "clock_domain",
    "fps_num",
    "fps_den",
    "total_frames",
    "canvas",
    "constraints_sha256",
    "subject_tracking_mode",
    "beats",
    "transitions",
    "layout_plan_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "kh03.layout_plan.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "selected_skill_id": { "type": "string", "enum": ["SK-01", "SK-02", "SK-03", "SK-04", "SK-05"] },
    "layout_policy": { "type": "string", "enum": ["ADAPTIVE_DYNAMIC", "FULLSCREEN_LOCK", "LEGACY_DYNAMIC"] },
    "clock_domain": { "type": "string", "enum": ["SOURCE_CLOCK", "OUTPUT_EDL_MAPPED"] },
    "time_map_sha256": { "type": ["string", "null"] },
    "fps_num": { "type": "integer", "minimum": 1 },
    "fps_den": { "type": "integer", "minimum": 1 },
    "total_frames": { "type": "integer", "minimum": 1 },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "aspect_ratio"],
      "properties": {
        "width": { "type": "integer", "minimum": 64 },
        "height": { "type": "integer", "minimum": 64 },
        "aspect_ratio": { "type": "string", "enum": ["9:16", "16:9", "1:1", "4:5"] }
      }
    },
    "constraints_sha256": { "type": "string", "minLength": 16 },
    "subject_tracking_mode": {
      "type": "string",
      "enum": [
        "STATIC_FALLBACK_VERIFIED",
        "LOCAL_TRACKER_VERIFIED",
        "LOCAL_DETECTOR_VERIFIED",
        "LOCAL_MOTION_SALIENT_TRACKED",
        "FACELESS_OBJECT_TRACKING",
        "TRACKING_STATIC_FALLBACK",
        "UNCERTAIN_CONSERVATIVE_FIT"
      ]
    },
    "tracking_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "scene_cut_frames": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "shared_element_ids": { "type": "array", "items": { "type": "string" } },
    "editorial_heuristic_disclaimer": { "type": "string" },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "layout_id", "beat_id", "semantic_function", "layout_mode",
          "start_frame", "end_frame", "presenter_box_norm", "presenter_box_px",
          "graphic_box_norm", "graphic_box_px", "caption_slot_norm",
          "source_crop", "presenter_z_order", "graphic_z_order",
          "border_radius_px", "score", "reason", "provenance"
        ],
        "properties": {
          "layout_id": { "type": "string", "minLength": 1 },
          "beat_id": { "type": "string", "minLength": 1 },
          "semantic_function": { "type": "string", "minLength": 1 },
          "layout_mode": {
            "type": "string",
            "enum": [
              "FULL_CANVAS", "PRESENTER_LEFT_SPLIT", "PRESENTER_RIGHT_SPLIT",
              "LOWER_COMPANION_SPLIT", "UPPER_COMPANION_SPLIT",
              "FLOATING_INSET_PRESENTER", "FULL_SCREEN_RETURN"
            ]
          },
          "start_frame": { "type": "integer", "minimum": 0 },
          "end_frame": { "type": "integer", "minimum": 1 },
          "src_start_frame": { "type": ["integer", "null"], "minimum": 0 },
          "src_end_frame": { "type": ["integer", "null"], "minimum": 1 },
          "presenter_box_norm": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
          "presenter_box_px": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer", "minimum": 0 } },
          "graphic_box_norm": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
          "graphic_box_px": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer", "minimum": 0 } },
          "caption_slot_norm": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
          "protected_masks_norm": { "type": "array", "items": { "type": "object" } },
          "source_crop": { "type": "object" },
          "presenter_z_order": { "type": "integer" },
          "graphic_z_order": { "type": "integer" },
          "border_radius_px": { "type": "integer", "minimum": 0, "maximum": 999 },
          "anchor": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
          "presenter_opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "mobile_face_width_px": { "type": "number", "minimum": 0 },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "reason": { "type": "string", "minLength": 1 },
          "asset_refs": { "type": "array", "items": { "type": "string" } },
          "provenance": { "type": "object" }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "transition_id", "from_layout_id", "to_layout_id", "from_beat_id",
          "to_beat_id", "from_mode", "to_mode", "start_frame", "end_frame",
          "duration_sec", "easing", "technique", "swept_presenter_bbox_norm", "reason"
        ],
        "properties": {
          "transition_id": { "type": "string", "minLength": 1 },
          "from_layout_id": { "type": "string", "minLength": 1 },
          "to_layout_id": { "type": "string", "minLength": 1 },
          "from_beat_id": { "type": "string", "minLength": 1 },
          "to_beat_id": { "type": "string", "minLength": 1 },
          "from_mode": { "type": "string" },
          "to_mode": { "type": "string" },
          "start_frame": { "type": "integer", "minimum": 0 },
          "end_frame": { "type": "integer", "minimum": 0 },
          "duration_sec": { "type": "number", "minimum": 0 },
          "easing": { "type": "string" },
          "technique": { "type": "string" },
          "swept_presenter_bbox_norm": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
          "reason": { "type": "string" }
        }
      }
    },
    "layout_plan_sha256": { "type": "string", "minLength": 16 }
  }
}
