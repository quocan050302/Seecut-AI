{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quocan050302/Seecut-AI/schemas/kh02/cut_candidate.schema.json",
  "title": "KH-02.R1 Rough Cut Candidates Contract",
  "type": "object",
  "required": ["schema_version", "source_asset_id", "source_sha256", "cut_policy", "candidates", "summary"],
  "properties": {
    "schema_version": { "type": "string", "const": "kh02r1.cut_candidates.v1" },
    "source_asset_id": { "type": "string", "minLength": 1 },
    "source_sha256": { "type": "string", "minLength": 8 },
    "cut_policy": {
      "type": "string",
      "enum": ["LOCK_VOICE", "PRESERVE_SCRIPT_TRIM", "EDITORIAL_CUT", "TRIM_APPROVED"]
    },
    "approval_scope": { "type": ["string", "null"] },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id", "source_asset_id", "candidate_type", "start_pts", "end_pts",
          "raw_duration_sec", "predicted_saving_sec", "confidence", "safety_ok",
          "proposed_outcome", "semantic_risk", "reason"
        ],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "source_asset_id": { "type": "string", "minLength": 1 },
          "candidate_type": {
            "type": "string",
            "enum": [
              "DEAD_AIR", "LEAD_TAIL_PADDING", "WAITING_FOR_UI", "REPEATED_TAKE",
              "FALSE_START", "FILLER", "STUMBLE", "OFF_TOPIC", "VISUAL_STALL",
              "REACTION", "DELIBERATE_PAUSE", "CONTEXT_REQUIRED", "TECHNICAL_DROPOUT"
            ]
          },
          "start_pts": { "type": "number", "minimum": 0 },
          "end_pts": { "type": "number", "minimum": 0 },
          "trim_start_pts": { "type": "number", "minimum": 0 },
          "trim_end_pts": { "type": "number", "minimum": 0 },
          "raw_duration_sec": { "type": "number", "minimum": 0 },
          "predicted_saving_sec": { "type": "number", "minimum": 0 },
          "word_ids": { "type": "array", "items": { "type": "string" } },
          "protected_word_ids": { "type": "array", "items": { "type": "string" } },
          "context_before": { "type": "string" },
          "context_after": { "type": "string" },
          "evidence_paths": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "safety_ok": { "type": "boolean" },
          "safety_blockers": { "type": "array", "items": { "type": "string" } },
          "proposed_outcome": {
            "type": "string",
            "enum": ["KEEP", "SHORTEN", "REMOVE", "REPLACE_VISUAL", "REVIEW"]
          },
          "semantic_risk": { "type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH"] },
          "rank_score": { "type": "number" },
          "reason": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_candidates", "approved_cut_count", "kept_count", "review_count", "predicted_total_saving_sec"],
      "properties": {
        "total_candidates": { "type": "integer", "minimum": 0 },
        "approved_cut_count": { "type": "integer", "minimum": 0 },
        "kept_count": { "type": "integer", "minimum": 0 },
        "review_count": { "type": "integer", "minimum": 0 },
        "predicted_total_saving_sec": { "type": "number", "minimum": 0 }
      }
    }
  }
}

