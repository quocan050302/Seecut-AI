{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quocan050302/Seecut-AI/schemas/kh02/brief.schema.json",
  "title": "KH-02 Editor Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "mode",
    "profile",
    "objective",
    "audience",
    "platform",
    "aspect_ratio",
    "language",
    "tone",
    "key_message",
    "voice_policy",
    "caption_policy",
    "music_policy",
    "sfx_policy",
    "license_decision",
    "sources"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["kh02.brief.v1", "kh02.brief.v2"] },
    "brief_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "mode": {
      "type": "string",
      "enum": [
        "talking_head", "software_demo", "product_demo", "tutorial",
        "education", "documentary", "narrative", "faceless",
        "montage", "interview", "custom"
      ]
    },
    "profile": {
      "type": "string",
      "enum": ["seecut_core", "editorial_pro", "minimal_documentary", "silent_visual"]
    },
    "objective": { "type": "string", "minLength": 3 },
    "audience": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "enum": ["reels", "tiktok", "shorts", "youtube", "square", "web", "custom"] },
    "aspect_ratio": { "type": "string", "enum": ["9:16", "16:9", "1:1", "4:5"] },
    "duration_policy": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["match_source", "target_range", "approved_trim"] },
        "min_sec": { "type": "number", "minimum": 0.5 },
        "max_sec": { "type": "number", "minimum": 0.5 }
      }
    },
    "language": { "type": "string", "minLength": 2 },
    "tone": { "type": "string", "minLength": 1 },
    "key_message": { "type": "string", "minLength": 1 },
    "proof_points": { "type": "array", "items": { "type": "string" } },
    "sensitive_claims": { "type": "array", "items": { "type": "string" } },
    "voice_policy": { "type": "string", "enum": ["LOCK_VOICE", "TRIM_APPROVED", "PRESERVE_SCRIPT_TRIM", "EDITORIAL_CUT", "SILENT_BY_DESIGN"] },
    "cut_policy": { "type": "string", "enum": ["LOCK_VOICE", "PRESERVE_SCRIPT_TRIM", "EDITORIAL_CUT", "TRIM_APPROVED"] },
    "energy_mode": { "type": "string", "enum": ["kinetic", "explanatory", "suspense", "calm", "emotional", "proof", "reaction", "payoff"] },
    "sfx_provider": { "type": "string", "enum": ["local", "mcp", "api", "auto", "off"] },
    "sfx_library_dirs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sfx_config_path": { "type": ["string", "null"] },
    "visual_stall_windows": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "number", "minimum": 0 }
      }
    },
    "presenter_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["LEGACY_DYNAMIC", "FIXED_PIP", "ADAPTIVE_PIP", "DYNAMIC_HYBRID", "FACELESS"]
        },
        "visibility": {
          "type": "string",
          "enum": ["ALWAYS_VISIBLE", "EDITORIAL_ALLOWED"]
        },
        "anchor": {
          "type": "string",
          "enum": ["TOP_LEFT", "TOP_RIGHT", "BOTTOM_LEFT", "BOTTOM_RIGHT", "CUSTOM"]
        },
        "custom_box": {
          "type": ["array", "null"],
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "shape": {
          "type": "string",
          "enum": ["ROUNDED_RECT", "CIRCLE"]
        },
        "width_ratio": { "type": "number", "minimum": 0.15, "maximum": 0.55 },
        "min_width_ratio": { "type": "number", "minimum": 0.15, "maximum": 0.45 },
        "max_width_ratio": { "type": "number", "minimum": 0.20, "maximum": 0.60 },
        "aspect_ratio": {
          "type": "string",
          "enum": ["SOURCE_AWARE", "PORTRAIT_3_4", "SQUARE_1_1", "PORTRAIT_9_16", "LANDSCAPE_16_9"]
        },
        "safe_zone_profile": {
          "type": "string",
          "enum": ["PLATFORM_AWARE", "REELS_SAFE", "TIKTOK_SAFE", "SHORTS_SAFE", "YOUTUBE_16_9", "MINIMAL"]
        },
        "face_tracking": {
          "type": "string",
          "enum": ["AUTO_WHEN_AVAILABLE", "STATIC_VERIFIED", "OFF"]
        },
        "occlusion_policy": {
          "type": "string",
          "enum": ["RESERVE_PRESENTER_ZONE", "LEGACY_CHECK_ONLY"]
        },
        "allow_fullscreen": { "type": "boolean" },
        "allow_anchor_switch": { "type": "boolean" },
        "allow_hide": { "type": "boolean" },
        "border_radius_px": { "type": "integer", "minimum": 0, "maximum": 999 },
        "guard_margin_ratio": { "type": "number", "minimum": 0.0, "maximum": 0.12 }
      }
    },
    "approved_scope": { "type": "string" },
    "caption_policy": { "type": "string", "enum": ["OFF", "ON_REQUESTED", "KEYWORDS_ONLY"] },
    "music_policy": { "type": "string", "enum": ["OFF", "OPTIONAL_LICENSED", "REQUIRED_LICENSED"] },
    "sfx_policy": { "type": "string", "enum": ["OPTIONAL_LICENSED", "OFF", "REQUIRED_LICENSED"] },
    "license_decision": {
      "type": "string",
      "enum": [
        "NONCOMMERCIAL_PERSONAL_EVALUATION_PERMITTED",
        "WRITTEN_COMMERCIAL_PERMISSION_VERIFIED",
        "BLOCKED_COMMERCIAL_LICENSE",
        "BLOCKED_LICENSE_UNRESOLVED"
      ]
    },
    "creative_theme": { "type": "string" },
    "cta_copy": { "type": ["string", "null"] },
    "approved_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "reason", "approved_by"],
        "properties": {
          "rule_id": { "type": "string" },
          "reason": { "type": "string" },
          "approved_by": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "path", "kind", "rights"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "root_id": { "type": "string" },
          "path": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["a_roll", "b_roll", "real_ui", "still_asset", "vo", "music", "sfx", "analysis_only"]
          },
          "rights": {
            "type": "string",
            "enum": ["OWNER_SUPPLIED_NONCOMMERCIAL", "LICENSED_COMMERCIAL", "CAPTURED_REAL_EVIDENCE_MASKED", "ANALYSIS_ONLY", "UNLICENSED"]
          },
          "label": { "type": "string" },
          "face_rect": {
            "type": ["array", "null"],
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_versions": { "type": "integer", "minimum": 1, "maximum": 3 },
        "allow_live_agy": { "type": "boolean" },
        "max_disk_gib": { "type": "number", "minimum": 0.5 }
      }
    }
  }
}
