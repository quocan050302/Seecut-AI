{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quocan050302/Seecut-AI/schemas/kh02/transcript.schema.json",
  "title": "KH-02 Normalized Transcript",
  "type": "object",
  "required": ["schema_version", "source_asset_id", "audio_sha256", "language", "model", "words", "phrases"],
  "properties": {
    "schema_version": { "type": "string", "const": "kh02.transcript.v1" },
    "source_asset_id": { "type": "string", "minLength": 1 },
    "audio_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "language": { "type": "string", "minLength": 1 },
    "language_probability": { "type": ["number", "null"] },
    "model": { "type": "string", "minLength": 1 },
    "cache_key": { "type": "string" },
    "duration_sec": { "type": "number", "minimum": 0 },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["word_id", "text", "start_sec", "end_sec", "speaker", "confidence"],
        "properties": {
          "word_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "start_sec": { "type": "number", "minimum": 0 },
          "end_sec": { "type": "number", "minimum": 0 },
          "speaker": { "type": "string" },
          "confidence": { "type": ["number", "null"] },
          "is_filler": { "type": "boolean" }
        }
      }
    },
    "phrases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phrase_id", "start_sec", "end_sec", "speaker", "word_ids", "text"],
        "properties": {
          "phrase_id": { "type": "string", "minLength": 1 },
          "start_sec": { "type": "number", "minimum": 0 },
          "end_sec": { "type": "number", "minimum": 0 },
          "speaker": { "type": "string" },
          "word_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "text": { "type": "string" },
          "gap_before_sec": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
