{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quocan050302/Seecut-AI/schemas/kh02/source_inventory.schema.json",
  "title": "KH-02 Source Inventory",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at_utc", "assets"],
  "properties": {
    "schema_version": { "type": "string", "const": "kh02.source_inventory.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "root_id", "canonical_path", "kind", "rights", "usable_in_render", "sha256", "size_bytes", "media"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "root_id": { "type": "string", "minLength": 1 },
          "canonical_path": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["a_roll", "b_roll", "real_ui", "still_asset", "vo", "music", "sfx", "analysis_only"] },
          "rights": { "type": "string" },
          "usable_in_render": { "type": "boolean" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "media": {
            "type": "object",
            "required": ["has_video", "has_audio"],
            "properties": {
              "has_video": { "type": "boolean" },
              "has_audio": { "type": "boolean" },
              "duration_sec": { "type": ["number", "null"], "minimum": 0 },
              "width": { "type": ["integer", "null"], "minimum": 1 },
              "height": { "type": ["integer", "null"], "minimum": 1 },
              "fps_num": { "type": ["integer", "null"], "minimum": 1 },
              "fps_den": { "type": ["integer", "null"], "minimum": 1 },
              "nb_frames": { "type": ["integer", "null"], "minimum": 0 },
              "is_vfr": { "type": "boolean" },
              "rotation_deg": { "type": "integer" },
              "sar": { "type": "string" },
              "video_codec": { "type": ["string", "null"] },
              "audio_codec": { "type": ["string", "null"] },
              "audio_sample_rate": { "type": ["integer", "null"] },
              "audio_channels": { "type": ["integer", "null"] },
              "color_space": { "type": ["string", "null"] }
            }
          },
          "face_rect": { "type": ["array", "string", "null"] },
          "silences": { "type": "array" },
          "speech_spans": { "type": "array" }
        }
      }
    }
  }
}
